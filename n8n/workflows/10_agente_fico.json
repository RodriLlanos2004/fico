    {
      "id": "10-resultado",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "notes": "Arma la respuesta y la fila de agent_logs. Tokens y costo quedan pendientes (hito H).",
      "parameters": {
        "jsCode": "const e = $('Inicio').first().json;\nconst a = $input.first().json;\nconst pasos = a.intermediateSteps ?? [];\nconst tools = pasos.map(s => s.action?.tool).filter(Boolean);\nconst error = a.error ? String(a.error.message ?? a.error).slice(0, 1000) : null;\nconst respuesta = a.output || 'Tuve un problema para responder. Intenta de nuevo en un minuto.';\nconst latencia = e.timestamp ? Date.now() - Date.parse(e.timestamp) : null;\n\n// Acciones para el iPhone: salen de lo que devolvieron crear_alarma / iniciar_temporizador.\nconst acciones_locales = [];\nfor (const s of pasos) {\n  if (!['crear_alarma', 'iniciar_temporizador'].includes(s.action?.tool)) continue;\n  try {\n    let o = typeof s.observation === 'string' ? JSON.parse(s.observation) : s.observation;\n    if (Array.isArray(o)) o = o[0];\n    o = o?.json ?? o;\n    if (o?.ok && o.data?.[0]) acciones_locales.push(o.data[0]);\n  } catch (err) { /* observacion no parseable: se ignora */ }\n}\n\nreturn [{ json: {\n  respuesta,\n  acciones_locales,\n  log: [e.session_id ?? null, e.canal ?? null, e.texto ?? '', JSON.stringify(tools), respuesta, latencia, error],\n} }];"
      }
    },
