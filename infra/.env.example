# Copia a .env (vm-bootstrap.sh lo genera solo). Nunca subas .env al repo.
# Las llaves de Telegram, Anthropic, OpenAI, Google y Supabase NO van aqui:
# viven cifradas en las credenciales de n8n.

# Dominio publico de n8n
FICO_DOMAIN=tusubdominio.duckdns.org

# DuckDNS
DUCKDNS_SUBDOMAIN=tusubdominio
DUCKDNS_TOKEN=

# Cifra las credenciales de n8n. Si se pierde, se pierden las credenciales.
# Generar: openssl rand -hex 32   (respaldala fuera de la VM)
N8N_ENCRYPTION_KEY=

# Token Bearer del webhook de Siri (32 bytes). Generar: openssl rand -hex 32
SIRI_TOKEN=
